FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 27;

boundaryField
{
    inlet   { type fixedValue; value uniform 27; }
    outlet  { type zeroGradient; }
    ground  { type omegaWallFunction; value uniform 27; }
    top     { type slip; }
    sides   { type slip; }
    kitten  { type omegaWallFunction; value uniform 27; }
}


